#!/usr/bin/env python3
"""Bounded local caller; launcher settings are controlled by root."""
import argparse,json,os,stat,subprocess,uuid
from pathlib import Path
parser=argparse.ArgumentParser()
parser.add_argument('--target',required=True)
parser.add_argument('--id',required=True)
parser.add_argument('--check',action='store_true')
args=parser.parse_args()
p=Path('/etc/openclaw-teams-call-launcher.json')
s=p.lstat()
if not stat.S_ISREG(s.st_mode) or s.st_uid!=0 or s.st_mode&0o022:
    parser.error('launcher configuration must be a root-owned regular file without group/other write permission')
c=json.loads(p.read_text())
for field in ('node','script','config'):
    if not os.path.isabs(c[field]):parser.error('launcher paths must be absolute')
command=['sudo','-n','systemd-run','--wait','--collect','--unit=teams-ring-'+uuid.uuid4().hex,
 '--uid='+c['user'],'--property=WorkingDirectory=/tmp','--property=RuntimeMaxSec=120',
 '--property=MemoryMax=900M','--property=TasksMax=256','--property=KillMode=control-group',
 '--',c['node'],c['script'],'--config',c['config'],'--target',args.target,'--id',args.id]
if args.check:command.append('--check')
raise SystemExit(subprocess.run(command).returncode)
